<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Draw under display cutouts. Without this, Android letterboxes the desktop away from the
         cutout's whole edge (a black band) even in immersive mode. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
